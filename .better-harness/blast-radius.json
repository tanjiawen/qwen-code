{
  "baseRef": "HEAD",
  "thresholds": {
    "changedFiles": { "warn": 20, "high": 40, "critical": 60 },
    "changedLines": { "warn": 600, "high": 1500, "critical": 3000 },
    "changedSymbols": { "warn": 12, "high": 28, "critical": 60 },
    "callerCount": { "warn": 10, "high": 30, "critical": 70 },
    "impactedSymbols": { "warn": 20, "high": 50, "critical": 120 },
    "impactedFiles": { "warn": 10, "high": 24, "critical": 48 },
    "reviewScore": 45
  },
  "ignore": [
    "integration-tests/**",
    "docs/**",
    "**/*.md",
    "**/dist/**",
    "**/node_modules/**"
  ],
  "core": [
    {
      "name": "core/backbone",
      "paths": ["packages/core/src/**"],
      "symbols": [],
      "risk": "high",
      "message": "packages/core 是架构主干，改动需 maintainer 级别把握；大改动（refactor 500+ 行）须 maintainer 发起。"
    },
    {
      "name": "core/auth-providers-models",
      "paths": [
        "packages/*/src/auth/**",
        "packages/*/src/providers/**",
        "packages/*/src/models/**"
      ],
      "symbols": [],
      "risk": "high",
      "message": "auth/providers/models 是核心基础设施，外部改动须 100% 确信或升级 maintainer。"
    },
    {
      "name": "core/config-tools-services",
      "paths": [
        "packages/*/src/config/**",
        "packages/*/src/tools/**",
        "packages/*/src/services/**"
      ],
      "symbols": [],
      "risk": "high",
      "message": "config/tools/services 属核心模块，跨包改动需评估全部下游消费者。"
    },
    {
      "name": "security/auth",
      "paths": [
        "**/auth/**",
        "**/security/**",
        "**/permission/**",
        "**/permissions/**",
        "**/crypto/**"
      ],
      "symbols": [
        "*auth*",
        "*Auth*",
        "authorize*",
        "validate*",
        "verify*",
        "encrypt*",
        "decrypt*",
        "sign*",
        "token*",
        "session*"
      ],
      "risk": "medium"
    },
    {
      "name": "delivery/infra",
      "paths": ["**/.github/workflows/**", "**/deploy/**", "**/infra/**"],
      "risk": "medium"
    }
  ]
}
